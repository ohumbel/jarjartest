<project name="jarjartest" default="jar-repackage" basedir=".">

    <property name="src.main.dir" location="src/main/java"/>
    <property name="src.main.resources.dir" location="src/main/resources"/>
    <property name="src.test.dir" location="src/test/java"/>
    <property name="src.test.resources.dir" location="src/test/resources"/>
    <property name="lib.dir" location="lib"/>
    <property name="build.dir" location="build"/>
    <property name="build.classes.dir" location="${build.dir}/classes"/>
    <property name="build.test-classes.dir" location="${build.dir}/test-classes"/>
    <property name="build.test-reports.dir" location="${build.dir}/test-reports"/>
    <property name="deployment.dir" location="deployment"/>

    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="anttasks.classpath">
        <pathelement location="${build.classes.dir}"/>
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="clean">
        <delete dir="${build.dir}" />
        <delete includeemptydirs="true" failonerror="false">
            <fileset dir="${deployment.dir}" includes="**/*" defaultexcludes="false" />
        </delete>
    </target>

    <target name="compile">
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="${src.main.dir}" destdir="${build.classes.dir}" includeantruntime="true" debug="true">
            <classpath refid="compile.classpath"/>
        </javac>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.main.resources.dir}" erroronmissingdir="false">
                <exclude name="**/.gitkeep"/>
            </fileset>
        </copy>
    </target>

    <target name="compile-test" depends="compile">
        <mkdir dir="${build.test-classes.dir}"/>
        <javac srcdir="${src.test.dir}" destdir="${build.test-classes.dir}" includeantruntime="true" debug="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <path refid="compile.classpath"/>
            </classpath>
        </javac>
        <copy todir="${build.test-classes.dir}">
            <fileset dir="${src.test.resources.dir}" erroronmissingdir="false">
                <exclude name="**/.gitkeep"/>
            </fileset>
        </copy>
    </target>

    <target name="test" depends="compile-test, jar-repackage">
        <mkdir dir="${build.test-reports.dir}"/>
        <junitlauncher printSummary="true" haltOnFailure="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test-classes.dir}"/>
                <path refid="compile.classpath"/>
            </classpath>
            <testclasses outputdir="${build.test-reports.dir}">
                <fileset dir="${build.test-classes.dir}">
                    <include name="**/*Test.class"/>
                </fileset>
                <listener type="legacy-brief" sendSysOut="true"/>
                <listener type="legacy-xml" sendSysOut="true"/>
            </testclasses>
        </junitlauncher>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${deployment.dir}"/>
        <jar destfile="${deployment.dir}/stextreme.jar" basedir="${build.classes.dir}"/>
    </target>

    <target name="jar-repackage" depends="jar">
        <taskdef name="jarjar" classname="com.eed3si9n.jarjar.JarJarTask">
            <classpath>
                <pathelement path="lib/ant-jarjar-1.18.1.jar" />
                <pathelement path="lib/jarjar-1.18.1.jar" />
                <pathelement path="lib/asm-9.11.1.jar" />
                <pathelement path="lib/asm-commons-9.11.1.jar" />
                <pathelement path="lib/asm-util-9.11.1.jar" />
            </classpath>
        </taskdef>
        <!-- produce a shadowed jar using jarjar - rules may apply for multiple jars -->
        <jarjar destfile="deployment/result.jar" filesonly="true">
            <zipfileset src="deployment/stextreme.jar"/>
            <!-- this is the initial jar - no direct repackaging rules -->
            <zipfileset src="lib/antlr-runtime-3.5.3.jar"/>
            <rule pattern="org.antlr.runtime.**" result="st.extreme.antlr.runtime.@1"/>
            <zipfileset src="lib/bcpkix-jdk18on-1.87.jar" excludes="META-INF/**"/>
            <zipfileset src="lib/bcprov-jdk18on-1.87.jar" excludes="META-INF/**"/>
            <rule pattern="org.bouncycastle.**" result="st.extreme.bouncycastle.@1"/>
            <zipfileset src="lib/commons-compress-1.28.0.jar" excludes="META-INF/versions/9/module-info.class"/>
            <rule pattern="org.apache.commons.compress.**" result="st.extreme.apache.commons.compress.@1"/>
            <zipfileset src="lib/commons-io-2.22.0.jar" excludes="META-INF/versions/9/module-info.class"/>
            <rule pattern="org.apache.commons.io.**" result="st.extreme.apache.commons.io.@1"/>
            <zipfileset src="lib/failureaccess-1.0.3.jar" excludes="META-INF/**"/>
            <!-- the com.google repackage rule also applies for failuraccess -->
            <zipfileset src="lib/guava-33.8.0-jre.jar" excludes="META-INF/**"/>
            <rule pattern="com.google.**" result="st.extreme.google.@1"/>
            <zipfileset src="lib/icu4j-79.1.jar"/>
            <rule pattern="com.ibm.icu.**" result="st.extreme.icu.@1"/>
            <zipfileset src="lib/jline-4.7.0.jar"/>
            <!-- no repackage rule for jline -->
        </jarjar>
    </target>

    <target name="verify-unmodified" depends="jar-repackage">
        <fail message="Verification failed: Unmodified class was not found in package st.extreme.initial in deployment/result.jar">
            <condition>
                <not>
                    <available classname="st.extreme.initial.Unmodified" classpath="deployment/result.jar"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="verify-antlr" depends="jar-repackage">
        <fail message="Verification failed: ANTLR runtime classes were not found in package st.extreme.antlr.runtime in deployment/result.jar">
            <condition>
                <not>
                    <and>
                        <available classname="st.extreme.antlr.runtime.Parser" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.antlr.runtime.Lexer" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.antlr.runtime.tree.CommonTree" classpath="deployment/result.jar"/>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Verification failed: ANTLR runtime classes were still found in package org.antlr.runtime in deployment/result.jar">
            <condition>
                <or>
                    <available classname="org.antlr.runtime.Parser" classpath="deployment/result.jar"/>
                    <available classname="org.antlr.runtime.Lexer" classpath="deployment/result.jar"/>
                </or>
            </condition>
        </fail>
        <taskdef name="verify-antlr-caller" classname="st.extreme.anttasks.VerifyAntlrCallerTask">
            <classpath refid="anttasks.classpath"/>
        </taskdef>
        <verify-antlr-caller jarfile="deployment/result.jar" classname="st.extreme.calling.Antlr"/>
    </target>

    <target name="verify-bouncycastle" depends="jar-repackage">
        <fail message="Verification failed: Bouncy Castle classes were not found in package st.extreme.bouncycastle in deployment/result.jar">
            <condition>
                <not>
                    <and>
                        <available classname="st.extreme.bouncycastle.jce.provider.BouncyCastleProvider" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.bouncycastle.crypto.Digest" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.bouncycastle.asn1.ASN1Object" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.bouncycastle.cert.X509CertificateHolder" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.bouncycastle.cms.CMSSignedData" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.bouncycastle.pkcs.PKCS10CertificationRequest" classpath="deployment/result.jar"/>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Verification failed: Bouncy Castle classes were still found in package org.bouncycastle in deployment/result.jar">
            <condition>
                <or>
                    <available classname="org.bouncycastle.jce.provider.BouncyCastleProvider" classpath="deployment/result.jar"/>
                    <available classname="org.bouncycastle.crypto.Digest" classpath="deployment/result.jar"/>
                    <available classname="org.bouncycastle.asn1.ASN1Object" classpath="deployment/result.jar"/>
                    <available classname="org.bouncycastle.cert.X509CertificateHolder" classpath="deployment/result.jar"/>
                    <available classname="org.bouncycastle.cms.CMSSignedData" classpath="deployment/result.jar"/>
                    <available classname="org.bouncycastle.pkcs.PKCS10CertificationRequest" classpath="deployment/result.jar"/>
                </or>
            </condition>
        </fail>
        <!-- No calling bouncycastle verification (only a _sslcerts.py file in jython does the import) -->
    </target>

    <target name="verify-commons-compress" depends="jar-repackage">
        <fail message="Verification failed: Apache Commons Compress classes were not found in package st.extreme.apache.commons.compress in deployment/result.jar">
            <condition>
                <not>
                    <and>
                        <available classname="st.extreme.apache.commons.compress.archivers.ArchiveEntry" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.compress.archivers.ArchiveStreamFactory" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.compress.archivers.zip.ZipArchiveEntry" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.compress.archivers.tar.TarArchiveEntry" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.compress.compressors.CompressorStreamFactory" classpath="deployment/result.jar"/>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Verification failed: Apache Commons Compress classes were still found in package org.apache.commons.compress in deployment/result.jar">
            <condition>
                <or>
                    <available classname="org.apache.commons.compress.archivers.ArchiveEntry" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.compress.archivers.ArchiveStreamFactory" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.compress.archivers.zip.ZipArchiveEntry" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.compress.archivers.tar.TarArchiveEntry" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.compress.compressors.CompressorStreamFactory" classpath="deployment/result.jar"/>
                </or>
            </condition>
        </fail>
        <taskdef name="verify-commons-compress-caller" classname="st.extreme.anttasks.VerifyCommonsCompressCallerTask">
            <classpath refid="anttasks.classpath"/>
        </taskdef>
        <verify-commons-compress-caller jarfile="deployment/result.jar" classname="st.extreme.calling.CommonsCompress"/>
    </target>

    <target name="verify-commons-io" depends="jar-repackage">
        <fail message="Verification failed: Apache Commons IO classes were not found in package st.extreme.apache.commons.io in deployment/result.jar">
            <condition>
                <not>
                    <and>
                        <available classname="st.extreme.apache.commons.io.IOUtils" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.io.FileUtils" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.io.FilenameUtils" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.io.input.AutoCloseInputStream" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.apache.commons.io.output.ByteArrayOutputStream" classpath="deployment/result.jar"/>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Verification failed: Apache Commons IO classes were still found in package org.apache.commons.io in deployment/result.jar">
            <condition>
                <or>
                    <available classname="org.apache.commons.io.IOUtils" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.io.FileUtils" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.io.FilenameUtils" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.io.input.AutoCloseInputStream" classpath="deployment/result.jar"/>
                    <available classname="org.apache.commons.io.output.ByteArrayOutputStream" classpath="deployment/result.jar"/>
                </or>
            </condition>
        </fail>
        <taskdef name="verify-commons-io-caller" classname="st.extreme.anttasks.VerifyCommonsIoCallerTask">
            <classpath refid="anttasks.classpath"/>
        </taskdef>
        <verify-commons-io-caller jarfile="deployment/result.jar" classname="st.extreme.apache.commons.compress.compressors.bzip2.BZip2CompressorInputStream"/>
    </target>

    <target name="verify-google" depends="jar-repackage">
        <fail message="Verification failed: Google classes were not found in package st.extreme.google in deployment/result.jar">
            <condition>
                <not>
                    <and>
                        <available classname="st.extreme.google.common.util.concurrent.internal.InternalFutureFailureAccess" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.google.common.util.concurrent.internal.InternalFutures" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.google.common.base.CharMatcher" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.google.common.collect.ImmutableList" classpath="deployment/result.jar"/>
                        <available classname="st.extreme.google.common.io.ByteStreams" classpath="deployment/result.jar"/>
                    </and>
                </not>
            </condition>
        </fail>
        <fail message="Verification failed: Google classes were still found in package com.google in deployment/result.jar">
            <condition>
                <or>
                    <available classname="com.google.common.util.concurrent.internal.InternalFutureFailureAccess" classpath="deployment/result.jar"/>
                    <available classname="com.google.common.util.concurrent.internal.InternalFutures" classpath="deployment/result.jar"/>
                    <available classname="com.google.common.base.CharMatcher" classpath="deployment/result.jar"/>
                    <available classname="com.google.common.collect.ImmutableList" classpath="deployment/result.jar"/>
                    <available classname="com.google.common.io.ByteStreams" classpath="deployment/result.jar"/>
                </or>
            </condition>
        </fail>
        <taskdef name="verify-google-caller" classname="st.extreme.anttasks.VerifyGoogleCallerTask">
            <classpath refid="anttasks.classpath"/>
        </taskdef>
        <verify-google-caller jarfile="deployment/result.jar" classname="st.extreme.calling.Google"/>
    </target>

    <target name="verify" depends="verify-unmodified, verify-antlr, verify-bouncycastle, verify-commons-compress, verify-commons-io, verify-google"/>

</project>
