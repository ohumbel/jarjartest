<project name="jarjartest" default="jar-repackage" basedir=".">

    <target name="clean">
        <delete includeemptydirs="true" failonerror="false">
            <fileset dir="deployment" includes="**/*" defaultexcludes="false" />
        </delete>
    </target>

    <target name="jar-repackage">
        <taskdef name="jarjar" classname="com.eed3si9n.jarjar.JarJarTask">
            <classpath>
                <pathelement path="lib/ant-jarjar-1.18.1.jar" />
                <pathelement path="lib/jarjar-1.18.1.jar" />
                <pathelement path="lib/asm-9.11.1.jar" />
                <pathelement path="lib/asm-commons-9.11.1.jar" />
                <pathelement path="lib/asm-util-9.11.1.jar" />
            </classpath>
        </taskdef>
        <!-- produce the big shadowed jar using jarjar -->
        <jarjar destfile="deployment/result.jar">
            <zipfileset src="lib/jline-4.7.0.jar"/>
            <rule pattern="org.jline.**" result="st.extreme.jline.@1"/>
        </jarjar>
    </target>

</project>
